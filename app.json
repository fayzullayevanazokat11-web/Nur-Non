{
  "expo": {
    "name": "Nur-Non",
    "slug": "nur-non-jbdnmr",
    "owner": "nur-non",
    "version": "1.1.0",
    "scheme": "nurnon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FCF4E4",
    "primaryColor": "#A05F27",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.nurnon.app",
      "versionCode": 2,
      "permissions": ["android.permission.CAMERA"],
      "backgroundColor": "#FCF4E4",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nurnon.app"
    },
    "plugins": [
      "expo-router",
      ["expo-font", { "fonts": ["./assets/fonts/Ionicons.ttf"] }],
      ["expo-image-picker", {
        "photosPermission": "Ertalabgi qop rasmlarini galereyadan tanlash uchun ruxsat kerak.",
        "cameraPermission": "Ertalabgi qoplarni rasmga olish uchun kamera kerak.",
        "microphonePermission": false
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "a323a38a-1eee-4be6-bde7-0a94258f205d"
      }
    }
  }
}
