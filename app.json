{
  "expo": {
    "name": "Nur-Non",
    "slug": "nur-non",
    "owner": "nur-non",
    "version": "1.0.0",
    "scheme": "nurnon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F2E6D5",
    "primaryColor": "#A06020",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.nurnon.app",
      "versionCode": 1,
      "backgroundColor": "#F2E6D5",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nurnon.app"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "d1b6767d-2885-4d43-8182-7fd1c2b49ea9"
      }
    }
  }
}
