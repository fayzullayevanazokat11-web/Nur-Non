{
  "expo": {
    "name": "Nur-Non",
    "slug": "nur-non",
    "owner": "nur-non",
    "version": "1.1.0",
    "scheme": "nurnon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FBF4E2",
    "primaryColor": "#93640E",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.nurnon.app",
      "versionCode": 2,
      "backgroundColor": "#FBF4E2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nurnon.app"
    },
    "plugins": [
      "expo-router",
      ["expo-font", { "fonts": ["./assets/fonts/Ionicons.ttf"] }]
    ],
    "extra": {
      "eas": {
        "projectId": "a323a38a-1eee-4be6-bde7-0a94258f205d"
      }
    }
  }
}
